# EXAMORA env — copy to .env
# Supabase — NEW EXAMORA project (NOT the existing "zelda" project).
# Paste from Supabase Dashboard → Project Settings → API (Project URL + anon key).
# Vite must prefix with VITE_. Without these the app falls back to localStorage (offline dev).
VITE_SUPABASE_URL=https://YOUR_NEW_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...YOUR_ANON_KEY...
# App
VITE_APP_NAME=EXAMORA
VITE_COLLEGE_TIMEZONE=Asia/Kolkata
# Running without VITE_SUPABASE_* leaves the app fully offline on the local mock store.
