# EXAMORA env — copy to .env
# Firebase (Vite must prefix with VITE_)
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=examora-demo
VITE_FIREBASE_STORAGE_BUCKET=demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000
VITE_FIREBASE_APP_ID=1:000:web:demo
# App
VITE_APP_NAME=EXAMORA
VITE_COLLEGE_TIMEZONE=Asia/Kolkata
VITE_USE_EMULATOR=true
# Leave Firebase vars as demo to run fully offline on local mock store.
