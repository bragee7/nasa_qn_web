rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.token.role == 'super_admin'; }
    function isStudent() { return isSignedIn() && request.auth.token.role == 'student'; }
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }
    match /students/{sid} {
      allow read: if isAdmin() || (isStudent() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /exams/{examId} {
      // students may read only published exams assigned to them (enforced by query + function payload strip)
      allow read: if isAdmin() || (isStudent() && resource.data.status in ['SCHEDULED','ACTIVE']);
      allow write: if isAdmin();
      match /snapshots/{v} { allow read: if isAdmin(); allow write: if isAdmin(); }
    }
    match /questionBank/{qid} {
      allow read, write: if isAdmin();
    }
    // Named question banks (one bank per exam; questions carry questionBankId).
    match /questionBanks/{bid} {
      allow read, write: if isAdmin();
    }
    // AI-assisted import staging (spec §24/§41): staged rows live OUTSIDE
    // questionBank until staff approval. Admin-only, like questionBank.
    match /questionImports/{iid} {
      allow read, write: if isAdmin();
    }
    match /importQuestions/{qid} {
      allow read, write: if isAdmin();
    }
    match /attempts/{aid} {
      allow read: if isAdmin() || (isStudent() && resource.data.uid == request.auth.uid);
      allow create: if isStudent();
      // updates only own in-progress attempt; score/status finalization via Functions only
      allow update: if isAdmin() || (isStudent() && resource.data.uid == request.auth.uid && resource.data.status == 'IN_PROGRESS');
      match /events/{eid} { allow read: if isAdmin() || (isStudent() && get(/databases/$(db)/documents/attempts/$(aid)).data.uid == request.auth.uid); allow create: if isSignedIn(); }
    }
    match /results/{rid} {
      allow read: if isAdmin() || (isStudent() && resource.data.uid == request.auth.uid && resource.data.released == true);
      allow write: if isAdmin();
    }
    match /adminAuditLogs/{lid} { allow read, write: if isAdmin(); }
  }
}
