rules_version='2'; service firebase.storage { match /b/{bucket}/o { match /question-images/{allPaths=**} { allow read: if request.auth != null; allow write: if request.auth != null && request.auth.token.role == 'super_admin'; } match /imports/{allPaths=**} { allow read, write: if request.auth != null && request.auth.token.role == 'super_admin'; } } }
